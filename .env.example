# ==== LLM (опционально) ====
# Без ключа работает детерминированный fallback-разбор намерений.
# Google AI Studio (бесплатный Gemini): ключ из aistudio.google.com/apikey,
# модель с префиксом gemini/ (напр. gemini-3.6-flash). BASE_URL не нужен.
LLM_API_KEY=
LLM_MODEL=gemini/gemini-3.6-flash
BASE_URL=
# ==== CORS ====
# Для pydantic-settings list[str] из env ожидает JSON-массив (не CSV!).
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
